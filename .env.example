DB_USER=postgres
DB_PASSWORD=change-me
POSTGRES_DB=mydb
SCRAPE_INTERVAL_MINUTES=1
KWORK_CONCURRENCY=4
KWORK_DELAY_MS=800
# Быстрый проход (первые N страниц) каждый тик; полный обход + закрытие пропавших заказов — раз в N минут
KWORK_FAST_PAGES=3
KWORK_FULL_SYNC_MINUTES=15
# Заказ закрывается, если не виден на сайте дольше N минут; закрытые удаляются из БД через N дней
KWORK_MISS_GRACE_MINUTES=20
KWORK_RETENTION_DAYS=7
